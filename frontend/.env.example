# Local dev: points at your locally-running backend (npm run dev in
# backend/, a normal always-on server).
VITE_API_URL=http://localhost:4000/api

# On Netlify: the API is served as a Netlify Function on the SAME domain
# as the frontend (see netlify.toml's /api/* redirect), so set this to the
# relative path "/api" instead — as a Netlify dashboard environment
# variable, not in this file (this .env is never deployed).

# Shows a role-switcher panel (bottom-left corner) for instantly testing
# manager/finance/viewer views without logging out and back in. Only takes
# effect in `npm run dev` (stripped entirely from production builds) and
# only works if the backend also has DEV_MODE=true set. Leave false in any
# shared or deployed environment.
VITE_DEV_MODE=false
