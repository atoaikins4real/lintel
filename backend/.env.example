SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PORT=4000
DEFAULT_CURRENCY=GHS

# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Set to true to auto-run billing (charge generation + late-payment
# flagging) once a day while the backend process is running.
ENABLE_CRON=false

# Set to true to enable POST /api/auth/dev-login, which issues a real
# session for a dedicated dev-manager/dev-finance/dev-viewer account with
# one click — for local testing only. Leave false (or unset) in any
# deployed environment.
DEV_MODE=false

# Comma-separated list of origins allowed to call this API from a browser
# (CORS allowlist). Defaults to localhost dev ports + the current Netlify
# domain if unset — override for a different Netlify domain.
FRONTEND_URL=http://localhost:5173,http://localhost:4173,https://lintelapp.netlify.app

# Set to "production" on any real deployment so unexpected server errors
# return a generic message instead of leaking exception details to clients.
NODE_ENV=production
