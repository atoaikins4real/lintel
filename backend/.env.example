SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PORT=4000
DEFAULT_CURRENCY=GHS

# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Set to true to auto-run billing (charge generation + late-payment
# flagging) once a day while the backend process is running.
ENABLE_CRON=false

# Set to true to enable POST /api/auth/dev-login, which issues a real
# session for a dedicated dev-manager/dev-finance/dev-viewer account with
# one click — for local testing only. Leave false (or unset) in any
# deployed environment.
DEV_MODE=false

# ---------------------------------------------------------------
# EMAIL
# Leave MAIL_PROVIDER unset and everything still works — messages are
# logged to the server output instead of sent, so you can test password
# resets without a provider. Set it when you're ready to send for real.
#
#   MAIL_PROVIDER=resend
#   MAIL_API_KEY=re_xxxxxxxx
#
# or any SMTP host (requires: npm i nodemailer)
#
#   MAIL_PROVIDER=smtp
#   MAIL_SMTP_URL=smtps://user:pass@smtp.example.com:465
#
# MAIL_FROM must be an address on a domain you've verified with the
# provider, or delivery will be rejected.
# ---------------------------------------------------------------
# MAIL_PROVIDER=
# MAIL_API_KEY=
# MAIL_SMTP_URL=
MAIL_FROM=Lintel <onboarding@resend.dev>

# Comma-separated list of origins allowed to call this API from a browser
# (CORS allowlist). Defaults to localhost dev ports + the current Netlify
# domain if unset — override for a different Netlify domain.
FRONTEND_URL=http://localhost:5173,http://localhost:4173,https://lintelapp.netlify.app

# Set to "production" if you deploy the backend somewhere other than
# Netlify, so unexpected server errors return a generic message instead of
# leaking exception details to clients. On Netlify itself, don't set this —
# Netlify's own CONTEXT=production var already covers it (see README), and
# NODE_ENV=production would make `npm install` skip devDependencies (vite)
# during the build.
# NODE_ENV=production
